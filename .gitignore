# Only reviewed application source and dependency/build metadata are tracked.
*
!/.gitignore
!/README.md
!/requirements.txt
!/whoop.py
!/weekly.py
!/report.py
!/backend/
/backend/*
!/backend/*.py
!/frontend/
/frontend/*
!/frontend/index.html
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/tsconfig.json
!/frontend/vite.config.ts
!/frontend/src/
/frontend/src/*
!/frontend/src/*.ts
!/frontend/src/*.tsx
!/frontend/src/*.css
